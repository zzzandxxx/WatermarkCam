<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wm_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="14dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_btn"
            android:clickable="true"
            android:contentDescription="返回"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_back"
            android:tint="@color/wm_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="拼图 · 汇报"
            android:textColor="@color/wm_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wm_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/modeRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="2dp" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/layoutScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>

    <EditText
        android:id="@+id/etTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/bg_edit"
        android:hint="汇报标题"
        android:inputType="text"
        android:maxLines="1"
        android:padding="12dp"
        android:textColor="@color/wm_text"
        android:textColorHint="@color/wm_text3"
        android:textSize="14sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/etNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/bg_edit"
        android:gravity="top"
        android:hint="汇报说明（选填）：今日进度、问题与计划…"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:padding="12dp"
        android:textColor="@color/wm_text"
        android:textColorHint="@color/wm_text3"
        android:textSize="14sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="还没有打卡照片\n先去拍几张，或点左上角「+」从相册选择"
            android:textColor="@color/wm_text3"
            android:textSize="13sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/wm_accent"
            android:visibility="gone" />
    </FrameLayout>

    <Button
        android:id="@+id/btnGenerate"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_primary_btn"
        android:stateListAnimator="@null"
        android:text="生成并保存"
        android:textColor="@color/wm_text"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
